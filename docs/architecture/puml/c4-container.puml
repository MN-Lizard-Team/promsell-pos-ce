@startuml C4_Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Promsell POS CE — Container Diagram (v0.9.4)

Person(merchant, "Merchant", "Shop owner / cashier")

System_Boundary(app, "Promsell POS CE (Flutter App)") {
    Container(ui, "Presentation Layer", "Flutter Widgets + BLoC/Cubit", "5-tab shell with adaptive sale: narrow cart bar/FAB, tablet dual-pane")
    Container(domain, "Domain Layer", "Pure Dart (CI-fenced)", "Entities, Money, Use Cases, Repository interfaces, ProductPage/SalePage/ReportSummary, shared/domain (Sale, SaleItem, SalePayment, SelectedProductOption, SalesPeriodTotals)")
    Container(data, "Data Layer", "Drift + SQLCipher", "Repository impls, Datasources, satang converters, Services, cursor pagination, streaming CSV export")
    ContainerDb(sqlite, "SQLite Database", "Drift ORM", "16 tables · schema v32, 32 satang columns, WAL, FK ON, UUIDv4 PKs, SQLCipher AES-256, cursor indexes + inventory_logs composite index")
    Container(pdf, "ReceiptPdfService", "pdf + printing packages", "80mm thermal PDF generation")
    Container(lifecycle, "DB Lifecycle Services", "@LazySingleton services", "MigrationSafetyService, WalCheckpointService, DatabaseHealthService, BackupExportService, BackupRestoreService, RecoveryKitService")
}

Rel(merchant, ui, "Taps, searches, checkout, backup/restore")
Rel(ui, domain, "Events / method calls")
Rel(domain, data, "Repository impl injected")
Rel(data, sqlite, "Drift queries + transactions + cursor pagination")
Rel(ui, pdf, "Print / share receipt")
Rel(lifecycle, sqlite, "PRAGMA wal_checkpoint, integrity_check, user_version, migrations")
Rel(lifecycle, domain, "BackupExportService uses AppLockService + BackupEncryptionService")

SHOW_LEGEND()
@enduml
