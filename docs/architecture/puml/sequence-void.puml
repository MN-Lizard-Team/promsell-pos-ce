@startuml Sequence_Void
title Void Sale Flow — Atomic Transaction (v0.9.2)

actor Merchant
participant "History UI" as UI
participant "HistoryBloc" as HB
participant "VoidSale" as UC
participant "AppLockService" as PIN
participant "SaleRepositoryImpl" as Repo
participant "SaleVoidWriter" as DS
participant "SaleDayGuard" as DG
participant "InventoryLogService" as ILS
database "SQLCipher SQLite" as DB

Merchant -> UI: Tap Void
UI -> UI: Confirm dialog + optional reason
Merchant -> UI: Confirm
UI -> HB: SaleVoidRequested
HB -> UC: call(saleId, reason)
UC -> PIN: requireSensitiveSession()\n(if store PIN on)
UC -> Repo: voidSale(saleId, reason)
Repo -> DS: voidSale(saleId, reason)

group Drift Transaction
    DS -> DG: assertVoidAllowed (in TX)
    DG -> DB: app_settings + daily_closes
    DS -> DB: SELECT sale WHERE id = saleId
    alt status == VOIDED
        DS --> Repo: throw BusinessRuleError("SaleAlreadyVoided")
    end

    DS -> DB: UPDATE sales SET\nstatus=VOIDED,\nvoidedAt=now,\nvoidReason=reason

    DS -> DB: SELECT sale_items WHERE saleId
    loop For each sale item
        DS -> DB: UPDATE products\nSET stock = stock + qty, version = version + 1, updated_at = now\nWHERE id = productId AND track_stock = 1
        DS -> ILS: logVoidReversal(productId, +qty, balanceAfter, saleId)
        ILS -> DB: INSERT inventory_logs\n(type=VOID_REVERSAL)
    end
    opt customer attached
        DS -> DB: UPDATE customers\n(total_spent + total_spent_satang reversal, visit_count - 1)
    end
end

DS --> Repo: void
Repo --> UC: void
UC --> UI: success
UI --> Merchant: Show "Sale voided" snackbar\n+ refresh list with VOIDED badge

@enduml
